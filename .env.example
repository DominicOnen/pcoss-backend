# Copy this file to .env for local development (.env is already git-ignored).
# On Render, set each of these under your service's "Environment" tab instead
# of using a .env file.

# --- Database (Supabase/Postgres connection string) ---
# IMPORTANT: rotate the password on this database — a previous version of
# main.py had it hardcoded and committed to GitHub.
DATABASE_URL=postgresql://postgres.xxxxx:NEW_PASSWORD_HERE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# --- Admin auth ---
# Shared password admin-sermons.html sends as the X-Admin-Key header.
# Make this long and random, e.g. `openssl rand -hex 24`
ADMIN_KEY=change-me-to-a-long-random-string

# --- Cloudflare R2 (gallery file uploads) ---
# Create a bucket in the Cloudflare dashboard -> R2, then an API token
# scoped to that bucket, then enable public access (or a custom domain)
# on the bucket to get R2_PUBLIC_URL.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=pcoss-gallery
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# --- Resend (contact form email notifications) ---
# Sign up at resend.com, verify a sending domain (or use their test
# onboarding@resend.dev sender while you set that up), then grab an API key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_TO_EMAIL=info@pcss-church.org
RESEND_FROM_EMAIL=PCOSS Website <onboarding@resend.dev>

# --- CORS ---
# Comma-separated list of extra origins allowed to call this API,
# e.g. once you attach a real custom domain to Cloudflare Pages.
CUSTOM_ORIGINS=https://www.your-real-domain.org
